[[target]]
name = "greet"
type = "library"
srcs = ["greet.py"]

[[target]]
name = "pass_test"
type = "test"
runner = "pytest"
srcs = ["test_pass.py"]
deps = [":greet"]

[[target]]
name = "fail_test"
type = "test"
runner = "pytest"
srcs = ["test_fail.py"]

[[target]]
name = "empty_test"
type = "test"
runner = "pytest"
srcs = ["test_empty.py"]

# Uses a fixture from the *repo root* conftest.py, not the package's.
[[target]]
name = "root_conftest_test"
type = "test"
runner = "pytest"
srcs = ["test_root_conftest.py"]

# The whole module skips itself on a missing optional package.
[[target]]
name = "modskip_test"
type = "test"
runner = "pytest"
srcs = ["test_modskip.py"]
